# REVIEW ONLY. Bind private values through secure host/runtime settings.
# This template neither deploys resources nor authorizes charges or provider requests.
SENTINEL_DATABASE_URL=
SENTINEL_ENVIRONMENT=production
SENTINEL_HOSTED_DEPLOYMENT=true
SENTINEL_COOKIE_SECURE=true
SENTINEL_CORS_ORIGINS=[]
SENTINEL_STORAGE_BACKEND=database
SENTINEL_REQUIRE_WORKERS_READY=true
# Set only the actual hosting ingress proxy addresses; never wildcard trust.
SENTINEL_FORWARDED_ALLOW_IPS=
SENTINEL_AUTO_MIGRATE=false
SENTINEL_MIGRATION_TARGET=d105a4143283
SENTINEL_SUPABASE_URL=https://cfslzvvdjxstpupkqbpw.supabase.co
SENTINEL_SUPABASE_SERVICE_ROLE_KEY=
# Bridge defaults to loopback plus PORT; no public API URL is required within the container.
SENTINEL_PAYPAL_MODE=sandbox
SENTINEL_PAYPAL_CLIENT_ID=
SENTINEL_PAYPAL_CLIENT_SECRET=
SENTINEL_PAYPAL_WEBHOOK_ID=4J572318CT6195232
SENTINEL_REFUND_EXECUTION_ENABLED=false
# Requested model ID; verify API/account availability before authorizing inference.
SENTINEL_AI_PROVIDER=openai
SENTINEL_AI_MODEL=gpt-6.1-terra
SENTINEL_AI_API_KEY=
# Example verification token/request bounds, not a monetary spending cap.
SENTINEL_AI_TIMEOUT_SECONDS=45
SENTINEL_AI_REQUEST_LIMIT=4
SENTINEL_AI_TOOL_CALLS_LIMIT=8
SENTINEL_AI_TOTAL_TOKENS_LIMIT=8000
# No persistent administrator bootstrap passwords. No public fixture ingress.
