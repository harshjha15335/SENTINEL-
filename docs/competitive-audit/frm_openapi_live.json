{"openapi":"3.1.0","info":{"title":"Risk Manager API","description":"Return-risk scoring, chargeback evidence, and abuse-ring detection for e-commerce merchants.","version":"0.1.0"},"paths":{"/score":{"post":{"tags":["score"],"summary":"Score","description":"Scores a single order through the trained XGBoost model, returning a\nrisk score, band, and the top SHAP-backed contributing factors.\n\nThis calls the real model artifact (ml/artifacts/model.pkl) — not a\nmock — via app.services.scorer, which wraps the same RiskExplainer\nclass covered by ml/tests/test_explainer.py.","operationId":"score_score_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/OrderInput"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ScoreResult"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/review":{"get":{"tags":["review"],"summary":"List Review Queue","description":"Returns the current review queue. Seeded (on first call, only when the\ntable is empty) from real holdout orders scored through the model and\nfiltered to medium/high risk band.","operationId":"list_review_queue_review_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"items":{"$ref":"#/components/schemas/ReviewCase"},"type":"array","title":"Response List Review Queue Review Get"}}}}}}},"/review/resolved":{"get":{"tags":["review"],"summary":"List Resolved Cases","description":"The audit trail: every case that's been approved or blocked, most\nrecently resolved first. Backed by SQLite (app/db/risk_manager.db),\nso — unlike the earlier in-memory version of this store — these\npersist across server restarts.","operationId":"list_resolved_cases_review_resolved_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"items":{"$ref":"#/components/schemas/ReviewCase"},"type":"array","title":"Response List Resolved Cases Review Resolved Get"}}}}}}},"/review/{order_id}":{"post":{"tags":["review"],"summary":"Resolve Review Case","operationId":"resolve_review_case_review__order_id__post","parameters":[{"name":"order_id","in":"path","required":true,"schema":{"type":"string","title":"Order Id"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ReviewResolveRequest"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ReviewCase"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/metrics":{"get":{"tags":["metrics"],"summary":"Get Metrics","description":"Serves the actual evaluation report produced by ml/evaluate.py against\nthe strictly time-split holdout set — not recomputed per request, and\nnot synthesized here. If this file is missing, that's a real signal\nthe model hasn't been evaluated yet, not something to paper over with\nfake numbers. Also attaches the return-risk model's headline stats\nand the XGBoost-vs-logistic-regression baseline comparison, if\ntrained, so the Dashboard reflects the full system, not just the\nchargeback model in isolation.","operationId":"get_metrics_metrics_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/MetricsReport"}}}}}}},"/graph":{"get":{"tags":["graph"],"summary":"Get Abuse Graph","description":"Returns the shared-identity network: customers connected via a device\nor shipping address they have in common with another customer. Built\nwith NetworkX connected-component clustering over the real train +\nholdout data — see app.services.graph_engine for the algorithm.","operationId":"get_abuse_graph_graph_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AbuseGraphData"}}}}}}},"/evidence/{order_id}":{"post":{"tags":["evidence"],"summary":"Create Evidence Packet","description":"Compiles a chargeback dispute evidence packet for a real order looked\nup from the train/holdout data, and renders it to an actual\ndownloadable PDF, served via the GET route below.\n\n404s on an order_id that doesn't exist in the dataset — this endpoint\nonly works against orders the system actually knows about, same as a\nreal merchant's order lookup would.","operationId":"create_evidence_packet_evidence__order_id__post","parameters":[{"name":"order_id","in":"path","required":true,"schema":{"type":"string","title":"Order Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/EvidencePacket"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/evidence-files/{order_id}.pdf":{"get":{"tags":["evidence"],"summary":"Download Evidence Pdf","description":"Serves the generated PDF with an explicit Content-Disposition:\nattachment header, so the browser forces a download regardless of\norigin. This matters specifically because the frontend (:5173) and\nthis API (:8000) are different origins in dev — the HTML anchor\n`download` attribute is silently IGNORED by browsers for cross-origin\nlinks, which is why a generic static-file mount (no explicit\ndisposition header) opened the PDF inline instead of downloading it.\nContent-Disposition, unlike the anchor attribute, is respected\nregardless of origin.","operationId":"download_evidence_pdf_evidence_files__order_id__pdf_get","parameters":[{"name":"order_id","in":"path","required":true,"schema":{"type":"string","title":"Order Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/fraud-spikes":{"get":{"tags":["spikes"],"summary":"Get Fraud Spikes","description":"Weekly chargeback rate with a trailing rolling z-score anomaly flag on\neach point. A different signal from /score (one order) and /graph\n(identity clustering) — this one watches the aggregate rate over time,\nthe way a fraud-ops dashboard would, and flags weeks that deviate\nsharply from their own recent baseline.\n\nAlso fires a real webhook notification (see services/alerting.py) if\nthe most recent week is a newly-detected spike — turns this from a\nchart you have to remember to check into something that actually\ntells you.","operationId":"get_fraud_spikes_fraud_spikes_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/FraudSpikeReport"}}}}}}},"/score/batch":{"post":{"tags":["batch"],"summary":"Score Batch Upload","description":"Scores every row in an uploaded CSV through both models. A merchant's\ndaily order export goes in; a risk-annotated CSV comes back,\ndownloadable via the csv_url in the response. Individual malformed\nrows are reported per-row rather than failing the whole upload — see\nbatch_scorer.py.","operationId":"score_batch_upload_score_batch_post","requestBody":{"content":{"multipart/form-data":{"schema":{"$ref":"#/components/schemas/Body_score_batch_upload_score_batch_post"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/BatchScoreSummary"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/batch-files/{filename}":{"get":{"tags":["batch"],"summary":"Download Batch Results","description":"Serves the annotated results CSV with an explicit Content-Disposition\nheader — same fix as the evidence PDF route. A generic static mount\nwould serve this inline instead of downloading, and a CSV opened\ninline just dumps raw text into the browser tab.","operationId":"download_batch_results_batch_files__filename__get","parameters":[{"name":"filename","in":"path","required":true,"schema":{"type":"string","title":"Filename"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/":{"get":{"tags":["health"],"summary":"Health Check","operationId":"health_check__get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}}},"components":{"schemas":{"AbuseGraphData":{"properties":{"nodes":{"items":{"$ref":"#/components/schemas/GraphNode"},"type":"array","title":"Nodes"},"links":{"items":{"$ref":"#/components/schemas/GraphLink"},"type":"array","title":"Links"},"ring_count":{"type":"integer","title":"Ring Count"},"rings":{"items":{"$ref":"#/components/schemas/RingSummary"},"type":"array","title":"Rings"}},"type":"object","required":["nodes","links","ring_count","rings"],"title":"AbuseGraphData"},"BaselineComparison":{"properties":{"comparison_threshold":{"type":"number","title":"Comparison Threshold"},"holdout_rows":{"type":"integer","title":"Holdout Rows"},"models":{"additionalProperties":true,"type":"object","title":"Models"},"roc_auc_improvement":{"type":"number","title":"Roc Auc Improvement"},"average_precision_improvement":{"type":"number","title":"Average Precision Improvement"}},"type":"object","required":["comparison_threshold","holdout_rows","models","roc_auc_improvement","average_precision_improvement"],"title":"BaselineComparison","description":"Answers \"why XGBoost, not something simpler?\" with an actual measured\ncomparison rather than an assumed answer — see\nml/train_baseline_model.py. On this dataset the honest result is that\na plain logistic regression baseline edges out XGBoost slightly\n(the synthetic data's generative process is linear in log-odds by\nconstruction), which is reported as-is, not hidden."},"BatchScoreRow":{"properties":{"row_number":{"type":"integer","title":"Row Number"},"order_id":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Order Id"},"risk_score":{"anyOf":[{"type":"number"},{"type":"null"}],"title":"Risk Score"},"risk_band":{"anyOf":[{"type":"string","enum":["low","medium","high"]},{"type":"null"}],"title":"Risk Band"},"recommended_action":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Recommended Action"},"return_risk_score":{"anyOf":[{"type":"number"},{"type":"null"}],"title":"Return Risk Score"},"return_risk_band":{"anyOf":[{"type":"string","enum":["low","medium","high"]},{"type":"null"}],"title":"Return Risk Band"},"error":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Error"}},"type":"object","required":["row_number"],"title":"BatchScoreRow"},"BatchScoreSummary":{"properties":{"total_rows":{"type":"integer","title":"Total Rows"},"scored_rows":{"type":"integer","title":"Scored Rows"},"failed_rows":{"type":"integer","title":"Failed Rows"},"high_risk_count":{"type":"integer","title":"High Risk Count"},"medium_risk_count":{"type":"integer","title":"Medium Risk Count"},"low_risk_count":{"type":"integer","title":"Low Risk Count"},"high_return_risk_count":{"type":"integer","title":"High Return Risk Count"},"generated_at":{"type":"string","title":"Generated At"},"csv_url":{"type":"string","title":"Csv Url"},"preview_rows":{"items":{"$ref":"#/components/schemas/BatchScoreRow"},"type":"array","title":"Preview Rows"}},"type":"object","required":["total_rows","scored_rows","failed_rows","high_risk_count","medium_risk_count","low_risk_count","high_return_risk_count","generated_at","csv_url","preview_rows"],"title":"BatchScoreSummary"},"Body_score_batch_upload_score_batch_post":{"properties":{"file":{"type":"string","contentMediaType":"application/octet-stream","title":"File"}},"type":"object","required":["file"],"title":"Body_score_batch_upload_score_batch_post"},"CostAssumptions":{"properties":{"false_positive_cost":{"type":"integer","title":"False Positive Cost"},"false_negative_cost":{"type":"integer","title":"False Negative Cost"}},"type":"object","required":["false_positive_cost","false_negative_cost"],"title":"CostAssumptions"},"DriftSlice":{"properties":{"slice":{"type":"string","title":"Slice"},"date_range":{"items":{"type":"string"},"type":"array","title":"Date Range"},"n_orders":{"type":"integer","title":"N Orders"},"precision":{"type":"number","title":"Precision"},"recall":{"type":"number","title":"Recall"},"positive_rate":{"type":"number","title":"Positive Rate"}},"type":"object","required":["slice","date_range","n_orders","precision","recall","positive_rate"],"title":"DriftSlice"},"EvidencePacket":{"properties":{"order_id":{"type":"string","title":"Order Id"},"generated_at":{"type":"string","title":"Generated At"},"sections":{"items":{"$ref":"#/components/schemas/EvidenceSection"},"type":"array","title":"Sections"},"pdf_url":{"type":"string","title":"Pdf Url"}},"type":"object","required":["order_id","generated_at","sections","pdf_url"],"title":"EvidencePacket"},"EvidenceSection":{"properties":{"title":{"type":"string","title":"Title"},"content":{"type":"string","title":"Content"},"included":{"type":"boolean","title":"Included"}},"type":"object","required":["title","content","included"],"title":"EvidenceSection"},"FeatureReason":{"properties":{"feature":{"type":"string","title":"Feature"},"label":{"type":"string","title":"Label"},"contribution":{"type":"number","title":"Contribution"},"raw_value":{"anyOf":[{"type":"number"},{"type":"string"}],"title":"Raw Value"}},"type":"object","required":["feature","label","contribution","raw_value"],"title":"FeatureReason"},"FraudRatePoint":{"properties":{"period_start":{"type":"string","title":"Period Start"},"order_count":{"type":"integer","title":"Order Count"},"chargeback_count":{"type":"integer","title":"Chargeback Count"},"chargeback_rate":{"type":"number","title":"Chargeback Rate"},"rolling_mean":{"anyOf":[{"type":"number"},{"type":"null"}],"title":"Rolling Mean"},"rolling_std":{"anyOf":[{"type":"number"},{"type":"null"}],"title":"Rolling Std"},"z_score":{"anyOf":[{"type":"number"},{"type":"null"}],"title":"Z Score"},"is_spike":{"type":"boolean","title":"Is Spike","default":false}},"type":"object","required":["period_start","order_count","chargeback_count","chargeback_rate"],"title":"FraudRatePoint"},"FraudSpikeReport":{"properties":{"granularity":{"type":"string","title":"Granularity"},"points":{"items":{"$ref":"#/components/schemas/FraudRatePoint"},"type":"array","title":"Points"},"spike_count":{"type":"integer","title":"Spike Count"},"latest_period":{"$ref":"#/components/schemas/FraudRatePoint"},"z_score_threshold":{"type":"number","title":"Z Score Threshold"},"alert_configured":{"type":"boolean","title":"Alert Configured","default":false},"alert_sent_for_current_spike":{"type":"boolean","title":"Alert Sent For Current Spike","default":false}},"type":"object","required":["granularity","points","spike_count","latest_period","z_score_threshold"],"title":"FraudSpikeReport"},"GraphLink":{"properties":{"source":{"type":"string","title":"Source"},"target":{"type":"string","title":"Target"}},"type":"object","required":["source","target"],"title":"GraphLink"},"GraphNode":{"properties":{"id":{"type":"string","title":"Id"},"type":{"type":"string","enum":["customer","device","address"],"title":"Type"},"label":{"type":"string","title":"Label"},"risk_score":{"anyOf":[{"type":"number"},{"type":"null"}],"title":"Risk Score"},"ring_id":{"type":"integer","title":"Ring Id"}},"type":"object","required":["id","type","label","ring_id"],"title":"GraphNode"},"HTTPValidationError":{"properties":{"detail":{"items":{"$ref":"#/components/schemas/ValidationError"},"type":"array","title":"Detail"}},"type":"object","title":"HTTPValidationError"},"MetricsReport":{"properties":{"holdout_rows":{"type":"integer","title":"Holdout Rows"},"holdout_positive_rate":{"type":"number","title":"Holdout Positive Rate"},"roc_auc":{"type":"number","title":"Roc Auc"},"average_precision":{"type":"number","title":"Average Precision"},"cost_assumptions_inr":{"$ref":"#/components/schemas/CostAssumptions"},"best_cost_weighted_threshold":{"$ref":"#/components/schemas/ThresholdSweepPoint"},"threshold_sweep":{"items":{"$ref":"#/components/schemas/ThresholdSweepPoint"},"type":"array","title":"Threshold Sweep"},"drift_analysis_at_best_threshold":{"items":{"$ref":"#/components/schemas/DriftSlice"},"type":"array","title":"Drift Analysis At Best Threshold"},"return_model":{"anyOf":[{"$ref":"#/components/schemas/ReturnModelSummary"},{"type":"null"}]},"baseline_comparison":{"anyOf":[{"$ref":"#/components/schemas/BaselineComparison"},{"type":"null"}]}},"type":"object","required":["holdout_rows","holdout_positive_rate","roc_auc","average_precision","cost_assumptions_inr","best_cost_weighted_threshold","threshold_sweep","drift_analysis_at_best_threshold"],"title":"MetricsReport"},"OrderInput":{"properties":{"order_id":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Order Id"},"account_age_days":{"type":"integer","title":"Account Age Days"},"is_new_account":{"type":"boolean","title":"Is New Account"},"order_value":{"type":"number","title":"Order Value"},"item_category":{"type":"string","title":"Item Category"},"payment_method":{"type":"string","title":"Payment Method"},"discount_pct":{"type":"number","title":"Discount Pct"},"shipping_billing_mismatch":{"type":"boolean","title":"Shipping Billing Mismatch"},"ip_country_mismatch":{"type":"boolean","title":"Ip Country Mismatch"},"device_reuse_signal":{"type":"boolean","title":"Device Reuse Signal"},"num_previous_orders":{"type":"integer","title":"Num Previous Orders"},"num_previous_returns":{"type":"integer","title":"Num Previous Returns"},"num_previous_chargebacks":{"type":"integer","title":"Num Previous Chargebacks"}},"type":"object","required":["account_age_days","is_new_account","order_value","item_category","payment_method","discount_pct","shipping_billing_mismatch","ip_country_mismatch","device_reuse_signal","num_previous_orders","num_previous_returns","num_previous_chargebacks"],"title":"OrderInput"},"ReturnModelSummary":{"properties":{"holdout_rows":{"type":"integer","title":"Holdout Rows"},"holdout_positive_rate":{"type":"number","title":"Holdout Positive Rate"},"roc_auc":{"type":"number","title":"Roc Auc"},"average_precision":{"type":"number","title":"Average Precision"},"band_thresholds":{"additionalProperties":true,"type":"object","title":"Band Thresholds"}},"type":"object","required":["holdout_rows","holdout_positive_rate","roc_auc","average_precision","band_thresholds"],"title":"ReturnModelSummary","description":"Headline stats for the SEPARATE return-risk model (see\nml/train_return_model.py), attached to the same /metrics response so\nthe Dashboard can show both models' health at a glance rather than\nonly ever reporting on the chargeback model. Sourced from\nartifacts_returns/train_holdout_meta.json — the return model's own\ntraining run output, not recomputed here."},"ReturnRiskResult":{"properties":{"risk_score":{"type":"number","title":"Risk Score"},"risk_band":{"type":"string","enum":["low","medium","high"],"title":"Risk Band"},"top_reasons":{"items":{"$ref":"#/components/schemas/FeatureReason"},"type":"array","title":"Top Reasons"}},"type":"object","required":["risk_score","risk_band","top_reasons"],"title":"ReturnRiskResult","description":"Output of the SECOND, independent model trained on the `returned`\nlabel (see ml/train_return_model.py) — not the chargeback model's\nscore reused as a proxy. Its own risk band, since the two models\nhave structurally different base rates and score distributions (see\nscorer.py's return_band_from_score)."},"ReviewCase":{"properties":{"order_id":{"type":"string","title":"Order Id"},"customer_id":{"type":"string","title":"Customer Id"},"order_value":{"type":"number","title":"Order Value"},"risk_score":{"type":"number","title":"Risk Score"},"risk_band":{"type":"string","enum":["low","medium","high"],"title":"Risk Band"},"top_reason_label":{"type":"string","title":"Top Reason Label"},"flagged_at":{"type":"string","title":"Flagged At"},"status":{"type":"string","enum":["pending","approved","blocked"],"title":"Status"},"resolved_at":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Resolved At"},"alert_sent":{"type":"boolean","title":"Alert Sent","default":false}},"type":"object","required":["order_id","customer_id","order_value","risk_score","risk_band","top_reason_label","flagged_at","status"],"title":"ReviewCase"},"ReviewResolveRequest":{"properties":{"status":{"type":"string","enum":["approved","blocked"],"title":"Status"}},"type":"object","required":["status"],"title":"ReviewResolveRequest"},"RingMember":{"properties":{"id":{"type":"string","title":"Id"},"label":{"type":"string","title":"Label"},"risk_score":{"type":"number","title":"Risk Score"}},"type":"object","required":["id","label","risk_score"],"title":"RingMember"},"RingSummary":{"properties":{"ring_id":{"type":"integer","title":"Ring Id"},"customer_count":{"type":"integer","title":"Customer Count"},"connection_type":{"type":"string","enum":["device","address","both"],"title":"Connection Type"},"max_risk_score":{"type":"number","title":"Max Risk Score"},"members":{"items":{"$ref":"#/components/schemas/RingMember"},"type":"array","title":"Members"}},"type":"object","required":["ring_id","customer_count","connection_type","max_risk_score","members"],"title":"RingSummary","description":"Ring-level context that used to require visually tracing graph edges\nby eye — who else is in this cluster, how severe is the worst member,\nand whether it's a shared device (a much stronger signal) or a shared\naddress (weaker — families and roommates legitimately share these)."},"ScoreResult":{"properties":{"order_id":{"type":"string","title":"Order Id"},"risk_score":{"type":"number","title":"Risk Score"},"risk_band":{"type":"string","enum":["low","medium","high"],"title":"Risk Band"},"top_reasons":{"items":{"$ref":"#/components/schemas/FeatureReason"},"type":"array","title":"Top Reasons"},"recommended_action":{"type":"string","enum":["approve","review","block"],"title":"Recommended Action"},"return_risk":{"$ref":"#/components/schemas/ReturnRiskResult"}},"type":"object","required":["order_id","risk_score","risk_band","top_reasons","recommended_action","return_risk"],"title":"ScoreResult"},"ThresholdSweepPoint":{"properties":{"threshold":{"type":"number","title":"Threshold"},"precision":{"type":"number","title":"Precision"},"recall":{"type":"number","title":"Recall"},"f1":{"type":"number","title":"F1"},"tp":{"type":"integer","title":"Tp"},"fp":{"type":"integer","title":"Fp"},"fn":{"type":"integer","title":"Fn"},"tn":{"type":"integer","title":"Tn"},"expected_cost_inr":{"type":"integer","title":"Expected Cost Inr"}},"type":"object","required":["threshold","precision","recall","f1","tp","fp","fn","tn","expected_cost_inr"],"title":"ThresholdSweepPoint"},"ValidationError":{"properties":{"loc":{"items":{"anyOf":[{"type":"string"},{"type":"integer"}]},"type":"array","title":"Location"},"msg":{"type":"string","title":"Message"},"type":{"type":"string","title":"Error Type"},"input":{"title":"Input"},"ctx":{"type":"object","title":"Context"}},"type":"object","required":["loc","msg","type"],"title":"ValidationError"}}}}