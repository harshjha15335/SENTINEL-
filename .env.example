# Copy to apps/api/.env. Never commit real values.
SENTINEL_ENVIRONMENT=development
SENTINEL_DATABASE_URL=postgresql+psycopg://sentinel:sentinel@127.0.0.1:5432/sentinel
SENTINEL_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
SENTINEL_COOKIE_SECURE=false

# sandbox = real PayPal sandbox requests (requires credentials below)
# fixture = offline simulated gateway; every record is labelled SIMULATED
SENTINEL_PAYPAL_MODE=sandbox
SENTINEL_PAYPAL_CLIENT_ID=
SENTINEL_PAYPAL_CLIENT_SECRET=
SENTINEL_PAYPAL_WEBHOOK_ID=

# Used only by `python -m app.cli seed`
SENTINEL_SEED_ADMIN_PASSWORD=
SENTINEL_SEED_ANALYST_PASSWORD=
SENTINEL_SEED_VIEWER_PASSWORD=

# Investigation agent (optional). provider: none | anthropic | openai.
# With none (or no key) SENTINEL produces deterministic summaries labelled as such.
SENTINEL_AI_PROVIDER=none
SENTINEL_AI_MODEL=
SENTINEL_AI_API_KEY=

# Evidence storage: local (contained directory, default var/storage) or database.
SENTINEL_STORAGE_BACKEND=local

# Full hosted integration: production + secure cookies + database evidence + fresh workers.
# Enable only on the actual HTTPS host, with same-origin CORS [] or explicit HTTPS origins.
SENTINEL_HOSTED_DEPLOYMENT=false
SENTINEL_REQUIRE_WORKERS_READY=false
# SENTINEL_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SENTINEL_SUPABASE_SERVICE_ROLE_KEY=  # server-only; supply securely, never a VITE_ value
# SENTINEL_BRIDGE_API_URL=http://127.0.0.1:8040
# SENTINEL_OPERATIONS_INBOX_MERCHANT_ID=  # UUID of the installation operator's merchant
# SENTINEL_FORWARDED_ALLOW_IPS=127.0.0.1  # inspect actual host proxy addresses
# Container startup upgrades only the reviewed revision; false requires manual migration.
SENTINEL_AUTO_MIGRATE=true
SENTINEL_MIGRATION_TARGET=d105a4143283
# Optional trusted operator CLI: private read-only judge tenant; at least 16 characters.
# SENTINEL_JUDGE_PASSWORD=  # never publish; repeated setup does not rotate it

# Default OFF; even when enabled, production environment refuses refunds.
SENTINEL_REFUND_EXECUTION_ENABLED=false
