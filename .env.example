# Copy to apps/api/.env. Never commit real values.
SENTINEL_ENVIRONMENT=development
SENTINEL_DATABASE_URL=postgresql+psycopg://sentinel:sentinel@127.0.0.1:5432/sentinel
SENTINEL_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
SENTINEL_COOKIE_SECURE=false

# sandbox = real PayPal sandbox requests (requires credentials below)
# fixture = offline simulated gateway; every record is labelled SIMULATED
SENTINEL_PAYPAL_MODE=sandbox
SENTINEL_PAYPAL_CLIENT_ID=
SENTINEL_PAYPAL_CLIENT_SECRET=
SENTINEL_PAYPAL_WEBHOOK_ID=

# Used only by `python -m app.cli seed`
SENTINEL_SEED_ADMIN_PASSWORD=
SENTINEL_SEED_ANALYST_PASSWORD=
SENTINEL_SEED_VIEWER_PASSWORD=
