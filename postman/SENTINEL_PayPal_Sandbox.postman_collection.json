{
  "info": {
    "_postman_id": "c508536e-b69c-44d8-a046-dea195ccfcf5",
    "name": "SENTINEL — PayPal Sandbox Authentication & Webhooks",
    "description": "PayPal Sandbox verification collection for SENTINEL. Contains non-financial OAuth token generation and webhook inspection endpoints with automated assertions, safe error classification, and Postman Local Vault secret references.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "PayPal Sandbox — Generate Access Token",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Check whether credentials are configured via Postman Local Vault or Environment",
              "let clientId = pm.environment.get('paypal_client_id');",
              "let clientSecret = pm.environment.get('paypal_client_secret');",
              "",
              "if (typeof pm.vault !== 'undefined' && typeof pm.vault.get === 'function') {",
              "    try {",
              "        // If using Postman Local Vault directly",
              "        pm.vault.get('paypal_client_id').then(function(val) {",
              "            if (val) console.log('Postman Local Vault: paypal_client_id resolved.');",
              "        }).catch(function() {});",
              "        pm.vault.get('paypal_client_secret').then(function(val) {",
              "            if (val) console.log('Postman Local Vault: paypal_client_secret resolved.');",
              "        }).catch(function() {});",
              "    } catch (e) {",
              "        // pm.vault async invocation fallback",
              "    }",
              "}",
              "",
              "if (!clientId || clientId === 'YOUR_SANDBOX_CLIENT_ID') {",
              "    console.warn('Notice: paypal_client_id is not set. Ensure it is populated in Postman Local Vault ({{vault:paypal_client_id}}) or Environment.');",
              "}",
              "if (!clientSecret || clientSecret === 'YOUR_SANDBOX_CLIENT_SECRET') {",
              "    console.warn('Notice: paypal_client_secret is not set. Ensure it is populated in Postman Local Vault ({{vault:paypal_client_secret}}) or Environment.');",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const status = pm.response.code;",
              "const debugId = pm.response.headers.get('paypal-debug-id');",
              "",
              "// Redaction assertion: Ensure secrets or vault tokens never leak into response text",
              "const secret = pm.environment.get('paypal_client_secret');",
              "if (secret && !secret.startsWith('{{vault:') && secret !== 'YOUR_SANDBOX_CLIENT_SECRET') {",
              "    pm.test('Response does not expose client secret', function () {",
              "        pm.expect(pm.response.text()).to.not.include(secret);",
              "    });",
              "}",
              "",
              "if (status === 200) {",
              "    pm.test('HTTP 200 OK — Access Token acquired', function () {",
              "        pm.response.to.have.status(200);",
              "    });",
              "",
              "    pm.test('OAuth token response conforms to PayPal schema', function () {",
              "        const data = pm.response.json();",
              "        pm.expect(data.access_token).to.be.a('string');",
              "        pm.expect(data.access_token.length).to.be.above(0);",
              "        pm.expect(data.token_type).to.match(/^Bearer$/i);",
              "        pm.expect(data.expires_in).to.be.a('number');",
              "        pm.expect(data.expires_in).to.be.above(0);",
              "        ",
              "        // Save access token to environment for downstream read-only webhook requests",
              "        pm.environment.set('paypal_access_token', data.access_token);",
              "    });",
              "} else if (status === 401) {",
              "    pm.test('HTTP 401 Unauthorized — Classified as invalid_client', function () {",
              "        pm.response.to.have.status(401);",
              "        const data = pm.response.json();",
              "        pm.expect(data.error).to.eql('invalid_client');",
              "    });",
              "    console.warn('PayPal OAuth returned 401 invalid_client. Debug-ID: ' + debugId + '. Check paired sandbox credentials and verify secret is not a proxy placeholder.');",
              "} else {",
              "    pm.test('Unexpected status code: ' + status, function () {",
              "        pm.expect(status).to.be.oneOf([200, 401]);",
              "    });",
              "}"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "{{paypal_client_id}}",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{paypal_client_secret}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded",
            "type": "text"
          }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "grant_type",
              "value": "client_credentials",
              "type": "text"
            }
          ]
        },
        "url": {
          "raw": "{{paypal_base_url}}/v1/oauth2/token",
          "host": [
            "{{paypal_base_url}}"
          ],
          "path": [
            "v1",
            "oauth2",
            "token"
          ]
        },
        "description": "Requests an OAuth 2.0 access token using client_credentials grant type and HTTP Basic Authentication. Credentials resolve from Postman Local Vault ({{vault:paypal_client_secret}}) or environment."
      },
      "response": []
    },
    {
      "name": "PayPal Sandbox — List Webhooks",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const token = pm.environment.get('paypal_access_token');",
              "if (!token) {",
              "    console.warn('Warning: paypal_access_token is missing. Execute Generate Access Token first.');",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Webhooks array is returned', function () {",
              "    const data = pm.response.json();",
              "    pm.expect(data).to.have.property('webhooks');",
              "    pm.expect(data.webhooks).to.be.an('array');",
              "    ",
              "    // If webhook id is not set and webhooks exist, save the first one",
              "    const currentWebhookId = pm.environment.get('paypal_webhook_id');",
              "    if ((!currentWebhookId || currentWebhookId === 'YOUR_SANDBOX_WEBHOOK_ID') && data.webhooks.length > 0) {",
              "        pm.environment.set('paypal_webhook_id', data.webhooks[0].id);",
              "        console.log('Discovered webhook id: ' + data.webhooks[0].id);",
              "    }",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{paypal_access_token}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{paypal_base_url}}/v1/notifications/webhooks",
          "host": [
            "{{paypal_base_url}}"
          ],
          "path": [
            "v1",
            "notifications",
            "webhooks"
          ]
        },
        "description": "Lists subscribed webhooks for the configured PayPal sandbox account using the Bearer token."
      },
      "response": []
    },
    {
      "name": "PayPal Sandbox — Show Webhook Details",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const token = pm.environment.get('paypal_access_token');",
              "const webhookId = pm.environment.get('paypal_webhook_id');",
              "if (!token) {",
              "    console.warn('Warning: paypal_access_token is missing. Execute Generate Access Token first.');",
              "}",
              "if (!webhookId || webhookId === 'YOUR_SANDBOX_WEBHOOK_ID') {",
              "    console.warn('Warning: paypal_webhook_id is not set. Execute List Webhooks or set manually.');",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Webhook details match requested ID', function () {",
              "    const data = pm.response.json();",
              "    const expectedId = pm.environment.get('paypal_webhook_id');",
              "    if (expectedId) {",
              "        pm.expect(data.id).to.eql(expectedId);",
              "    }",
              "    pm.expect(data).to.have.property('url');",
              "    pm.expect(data).to.have.property('event_types');",
              "    pm.expect(data.event_types).to.be.an('array');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{paypal_access_token}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{paypal_base_url}}/v1/notifications/webhooks/{{paypal_webhook_id}}",
          "host": [
            "{{paypal_base_url}}"
          ],
          "path": [
            "v1",
            "notifications",
            "webhooks",
            "{{paypal_webhook_id}}"
          ]
        },
        "description": "Retrieves configuration details and subscribed event types for a specific webhook ID."
      },
      "response": []
    }
  ]
}
